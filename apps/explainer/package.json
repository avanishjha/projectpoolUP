{
  "name": "@conqr/explainer",
  "version": "0.1.0",
  "private": true,
  "description": "CONQR explainer film — 120s, 1920x1080, every frame a pure function of time, rendered with Remotion.",
  "type": "module",
  "scripts": {
    "fonts": "tsx scripts/sync-fonts.ts",
    "metrics": "tsx scripts/build-font-metrics.ts",
    "studio": "pnpm fonts && remotion studio src/index.ts",
    "render": "pnpm fonts && remotion render src/index.ts ConqrExplainer out/conqr-explainer.mp4",
    "stills": "pnpm fonts && tsx scripts/render-stills.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534",
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.9",
    "opentype.js": "^1.3.4",
    "@types/opentype.js": "^1.3.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
