{
  "name": "conqr",
  "version": "0.1.0",
  "private": true,
  "description": "CONQR — accountability challenges with real-money stakes. India-first.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:authz-seed": "pnpm --filter @conqr/authz gen:sql-seed",
    "seed:images": "node -e \"const{execSync}=require('child_process');const s=JSON.parse(execSync('supabase status -o json').toString());process.env.SUPABASE_SERVICE_ROLE_KEY=s.SERVICE_ROLE_KEY;process.env.SUPABASE_URL=s.API_URL;require('child_process').execSync('node scripts/seed-images.mjs',{stdio:'inherit',env:process.env});\"",
    "db:reset": "supabase db reset && pnpm seed:images"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
